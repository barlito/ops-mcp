# ops-mcp environment
#
# You do NOT need a .env file to run the stack: docker-compose.yaml (local) and
# docker-compose-prod.yml (prod) set the runtime environment themselves, and `make deploy` sets
# IMAGE_TAG, HOST_UID, HOST_GID and CONFIG_VERSION. Both compose files require ADMIN_PROXY_SECRET and
# ADMIN_WEB_SECRET in the environment: `make deploy` generates them once into data/admin-*-secret
# (local); prod deploys read them from GitHub secrets (see docs/DEPLOY.md).
#
# These are the variables to set when running the server OUTSIDE Docker (`npm run dev` with Node 24),
# or to know what compose configures. Export them in your shell; nothing loads this file.

# SQLite file for tokens, connector keys and the audit log (required). Its directory must exist.
DB_PATH=./data/ops.db

# Registry of the servers to inspect (required, validated at startup; see config/registry.local.yaml).
REGISTRY_PATH=./config/registry.local.yaml

# HTTP port.
PORT=3000

# Comma-separated hostnames, IPs or CIDRs allowed to set X-Forwarded-For (hostnames re-resolved every
# 60 s). Empty = trust nobody. Also required for the web admin UI. In Swarm behind Traefik:
# tasks.traefik_traefik
TRUSTED_PROXY=

# Web admin UI (behind Traefik + Authelia). It stays DISABLED unless TRUSTED_PROXY is set and
# ADMIN_PROXY_SECRET has at least 32 characters.
ADMIN_WEB_PORT=3002
# Authelia group (Remote-Groups) allowed in.
ADMIN_GROUP=admins
# Value Traefik injects as X-Ops-Admin-Proxy after Authelia (openssl rand -hex 32).
# ADMIN_PROXY_SECRET=
# CSRF key and sealing key of the connector keys; if unset the CSRF key is random per boot and keys
# cannot be revealed again.
# ADMIN_WEB_SECRET=
# Authelia session cookie name the CSRF token is bound to.
AUTHELIA_SESSION_COOKIE=authelia_session

# Public MCP URL shown in the ready-to-paste `claude mcp add` command.
# PUBLIC_MCP_URL=https://ops.barlito.fr/mcp

# Throttling (defaults shown): authenticated calls per credential per minute, concurrent requests in
# total and per client, audit rows for failed logins per minute.
# MCP_CALLS_PER_MIN=300
# MCP_MAX_CONCURRENT=16
# MCP_MAX_CONCURRENT_PER_CLIENT=8
# AUTH_AUDIT_MAX_PER_MIN=30
