{
  "name": "ops-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only MCP server to diagnose production (Swarm state, logs, metrics, deploys) without SSH.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test $(find src -name '*.test.ts' | sort)",
    "test.integration": "tsx --test $(find src -name '*.it.ts' | sort)"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.1.1",
    "express": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=24"
  }
}
